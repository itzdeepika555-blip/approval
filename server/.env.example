# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sih_maharashtra_navigator?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="super-secret-jwt-access-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=10485760 # 10MB
ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/png"

# Optional AI Engine Configuration (Gemini API for OCR & explanation assistance)
GEMINI_API_KEY=""
AI_ENABLED=true
